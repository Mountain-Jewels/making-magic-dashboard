# Making Magic Control Console - Environment Variables
# Copy this file to .env.local and fill in values

# API URL - the Making Magic orchestration API
NEXT_PUBLIC_API_URL=https://making-magic-api.orangemushroom-9c6ca205.eastus.azurecontainerapps.io

# API Key (if auth is enabled on the API)
NEXT_PUBLIC_API_KEY=<API_KEY>

# The Studio Director API (AI production engine)
NEXT_PUBLIC_STUDIO_API_URL=http://localhost:8100
