# Mountain Jewels Studio Dashboard — Environment Variables
# Copy to .env.local and fill in values

# Studio Engine API
NEXT_PUBLIC_STUDIO_ENGINE_URL=http://localhost:8100

# Azure AD (MSAL)
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_API_CLIENT_ID=

# Auth mode ("msal" for Azure AD, "dev" for local dev)
NEXT_PUBLIC_AUTH_MODE=msal

# Pixel Streaming
NEXT_PUBLIC_PIXEL_STREAM_URL=

# Feature flags
NEXT_PUBLIC_FEATURE_ASSETS_TAB=true
