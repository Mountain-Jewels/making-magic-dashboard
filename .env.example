# Making Magic Dashboard — Environment Variables
# Copy to .env.local and fill in values

# Studio Engine API (single backend for all API calls)
NEXT_PUBLIC_STUDIO_ENGINE_URL=http://localhost:8100

# Azure AD (MSAL)
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_API_CLIENT_ID=

# Auth mode ("msal" for Azure AD, "none" to disable)
NEXT_PUBLIC_AUTH_MODE=msal

# Scraper API (optional, for scraper features)
NEXT_PUBLIC_SCRAPER_API_URL=

# Pixel Streaming (optional, for live 3D streaming)
NEXT_PUBLIC_PIXEL_STREAM_URL=

# Feature flags
NEXT_PUBLIC_FEATURE_ASSETS_TAB=true
